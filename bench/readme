#!/usr/bin/env node
'use strict';
// The README against a benchmark run: what it shows the gate say and the numbers it gives must be what
// that run gave. Checked:
//   the scene    - the gate's reply in the README's code block, after Claude Code's frame (`⎿` and
//                  LABEL), is the reply of the run on SCENE, word for word (lines may wrap at any space:
//                  how Claude Code wraps them is its own output, which no run here gives);
//   the table    - "What else it catches": HEADER, then one row per case of ROWS, in order, with its
//                  text; "Plain test run" is the run's tests-only outcome, and the greenwashing cell is
//                  a finding ("- ") or "Result: " line of the gate's own words on that case, without
//                  that start (the test output it quotes after "Last N lines" is not the gate's);
//   the numbers  - the summary table of the run's RESULTS.md stands in "Numbers" as it is;
//   other digits - no other number in the README, apart from catalog entries (GW-NN, their links), the
//                  oldest Node the gate runs on (MIN_NODE) and FRAME;
//   images       - none but BADGE and the banner: BANNER alone on a line, once, its alt text holding the
//                  first line of the run's reply on SCENE (spaces and line ends squashed, as in the scene;
//                  the digits of that line are the run's);
//   the links    - every GW-NN outside code is a link to its entry's heading in CATALOG.md.
// Markdown the check cannot read the way GitHub shows it is refused, not guessed at: HTML and its
// entities, a code fence other than a bare ```, an indented line (code to GitHub), a | outside the tables
// it reads (a row to GitHub), a heading it does not see (indented, a tab after its #, a line of = or -
// under it), a "## " title twice, a character that is no plain space or does not show, the gate's frame
// outside the scene. Lines end at CRLF, CR or LF, as in Markdown; a table runs from a line that starts
// with | to the next blank line, as GitHub reads it.
//
//   node bench/readme [<folder>]
//
// <folder>: where bench/run wrote RESULTS.md, results.json and replies.json (default: bench/). Exit 0:
// the README matches; 1: it does not (each difference printed); 2: did not run (a file missing or
// unreadable, or a case the README shows that the run has no reply or outcome for).

const fs = require('node:fs');
const path = require('node:path');
const { MIN_NODE } = require('../gate/lib/command');

const ROOT = path.resolve(__dirname, '..');
// The case whose gate reply the README's scene shows, and the rows of its table, in order: each case
// with what the README says the agent did there.
const SCENE = 'fake-deleted-test-js';
const HEADER = '| What the agent did | Plain test run | greenwashing |';
const ROWS = [
  ['fake-skip-js', 'Marked the failing test `skip`'],
  ['fake-no-assertion-js', 'Wrote a test that checks nothing'],
  ['fake-dummy-command-js', 'Made the test command print a pass without running tests'],
];
// Claude Code's frame around the reply (2.1.286): the line above it, and the label the reply follows on
// a line that holds only `⎿` and spaces before it.
const FRAME = '● Ran 1 stop hook';
const LABEL = 'Stop hook error: ';
// The "Plain test run" cell for each tests-only outcome.
const PLAIN = { green: '✅ green', red: '❌ red' };
// The images: the license badge, linked to the license, and the banner, with its alt text. An alt text
// with a bracket or a backslash is refused: GitHub can read the line as text and a link, not the image.
const BADGE = '[![License: MIT](https://img.shields.io/badge/license-MIT-blue.svg)](LICENSE)';
const BANNER = /^!\[([^[\]\\]*)\]\(docs\/banner\.png\)$/;

// Spaces, tabs and line ends as one space: where lines wrap is the frame's.
const squash = (text) => text.replace(/[ \t\r\n]+/g, ' ').trim();
// A catalog link as its text: [GW-17](CATALOG.md#...) -> GW-17. No other link is read.
const GW_LINK = /\[(GW-\p{N}+)\]\(([^()\s]*)\)/gu;
const unlinkEntries = (text) => text.replace(GW_LINK, (link, entry, target) => (target.startsWith('CATALOG.md#') ? entry : link));
// GitHub's anchor of a heading: lower case, only letters, digits, spaces, hyphens and underscores
// kept, a hyphen for each space.
const slug = (heading) => heading.toLowerCase().replace(/[^\p{L}\p{N} _-]/gu, '').replace(/ /g, '-');
// The first number of a text that the digit rule reads: catalog entries, the targets of their links
// and the oldest Node (minNode) go first.
const numberIn = (text, minNode) => text.replace(/\]\(CATALOG\.md#[^()\s]*\)/g, ']').replace(/GW-\p{N}+/gu, '')
  .replace(new RegExp(`(?<![\\p{L}\\p{N}])Node ${minNode}\\+`, 'gu'), '').match(/\p{N}/u);
// Text outside code spans; an escaped backtick opens none.
const outsideCode = (line) => line.replace(/\\`/g, '').replace(/`[^`]*`/g, '');
// A character that is no plain space or tab and is a space, a line or paragraph separator, a format or a
// control character: GitHub shows it as a space, as nothing, or as an end of line.
const ODD = /(?![ \t])[\p{Z}\p{Cf}\p{Cc}]/u;

// The README's lines, its fenced code blocks ({from, to}: the fence lines; to is null for one never
// closed, which runs to the end), its "## " sections ({title: [from, to)}, and the titles found twice)
// and its tables ([from, to)).
function parse(text) {
  const lines = text.split(/\r\n|\r|\n/);
  const blocks = [];
  let open = null;
  for (const [i, line] of lines.entries()) {
    if (line !== '```') continue;
    if (open === null) open = i;
    else {
      blocks.push({ from: open, to: i });
      open = null;
    }
  }
  if (open !== null) blocks.push({ from: open, to: null });
  const inBlock = (i) => blocks.some((b) => i >= b.from && (b.to === null || i <= b.to));
  // A section runs to the next heading of level 1 or 2.
  const headings = lines.map((line, i) => (/^#{1,2} /.test(line) && !inBlock(i) ? i : -1)).filter((i) => i >= 0);
  const sections = {};
  const twice = [];
  for (const [k, i] of headings.entries()) {
    if (!lines[i].startsWith('## ')) continue;
    const title = lines[i].slice(3).trim();
    if (title in sections) twice.push(title);
    sections[title] = [i + 1, k + 1 < headings.length ? headings[k + 1] : lines.length];
  }
  const tables = [];
  for (let i = 0; i < lines.length; i += 1) {
    if (!lines[i].startsWith('|') || inBlock(i)) continue;
    let end = i;
    while (end < lines.length && !/^[ \t]*$/.test(lines[end]) && !inBlock(end)) end += 1;
    tables.push([i, end]);
    i = end;
  }
  return { lines, blocks, sections, twice, tables, inBlock };
}

// The cells of a table row, without the outer pipes; \| is a pipe inside a cell.
const cells = (row) => row.trim().replace(/^\|/, '').replace(/\|$/, '').split(/(?<!\\)\|/).map((cell) => cell.trim().replace(/\\\|/g, '|'));

// Where two texts first differ, to say it in a line.
function firstDifference(a, b) {
  let i = 0;
  while (i < a.length && i < b.length && a[i] === b[i]) i += 1;
  const at = (text) => JSON.stringify(text.slice(Math.max(0, i - 30), i + 50));
  return `the README has ${at(a)}, the run ${at(b)}`;
}

// The checks: {problems, notRun, checked}. run: {resultsMd, results, replies} of one bench run; minNode:
// the oldest Node the README may name.
function check(readme, run, catalog, minNode = MIN_NODE) {
  const problems = [];
  const notRun = [];
  const checked = [];
  const { lines, blocks, sections, twice, tables, inBlock } = parse(readme);
  const byId = new Map((run.results.cases || []).map((c) => [c.id, c]));
  const reply = (id) => (typeof run.replies[id] === 'string' ? run.replies[id] : null);
  // A column's outcome of a case in the run, or null.
  const outcome = (id, column) => {
    const c = byId.get(id);
    return c && c[column] && typeof c[column].outcome === 'string' ? c[column].outcome : null;
  };
  // The lines a run decides, with the part of each that the digit rule below still reads: nothing of
  // the scene's reply, of FRAME or of the numbers table; the first two cells of a row of the table; the
  // banner's line without the first line of the reply on SCENE (nothing of it when the run has none).
  const decided = new Map();
  const inTable = (i) => tables.some(([from, to]) => i >= from && i < to);
  const tablesIn = (title) => (sections[title] ? tables.filter(([from]) => from >= sections[title][0] && from < sections[title][1]) : []);

  // What the check cannot read as GitHub shows it.
  for (const b of blocks) if (b.to === null) problems.push(`line ${b.from + 1}: a code block that is never closed`);
  for (const title of twice) problems.push(`the section "## ${title}" is there twice`);
  for (const [i, line] of lines.entries()) {
    const odd = line.match(ODD);
    if (odd) problems.push(`line ${i + 1}: U+${odd[0].codePointAt(0).toString(16).toUpperCase().padStart(4, '0')}, a character that is no plain space or does not show`);
    if (/^ {0,3}(?:`{3,}|~{3,})/.test(line) && line !== '```') problems.push(`line ${i + 1}: a code fence other than a bare \`\`\`: ${line.trim()}`);
    if (inBlock(i)) continue;
    if (/<(?:!--|\/?[A-Za-z])/.test(outsideCode(line))) problems.push(`line ${i + 1}: HTML, which this check does not read: ${line.trim()}`);
    if (/&(?:#[0-9]+|#[xX][0-9a-fA-F]+|[A-Za-z][A-Za-z0-9]*);/.test(outsideCode(line))) problems.push(`line ${i + 1}: an HTML entity, which this check does not read: ${line.trim()}`);
    if (/^ {1,3}#{1,6}(?:[ \t]|$)|^#{1,6}\t/.test(line)) problems.push(`line ${i + 1}: a heading this check does not read: ${line.trim()}`);
    if (!inTable(i) && /^ {0,3}(?:=+|-+|(?:-[ \t]*){3,}|(?:\*[ \t]*){3,}|(?:_[ \t]*){3,})[ \t]*$/.test(line)) {
      problems.push(`line ${i + 1}: a line of = or - (a heading's underline or a break), which this check does not read`);
    }
    if (/^(?: {4}|\t)\s*\S/.test(line)) problems.push(`line ${i + 1}: an indented line, which GitHub can show as code: ${line.trim()}`);
    if (!inTable(i) && /(?<!\\)\|/.test(outsideCode(line))) problems.push(`line ${i + 1}: a | outside the tables, which GitHub can show as a table row: ${line.trim()}`);
  }

  // The scene.
  const scenes = blocks.filter((b) => lines.slice(b.from + 1, b.to === null ? lines.length : b.to).some((line) => line.includes(LABEL)));
  if (scenes.length !== 1) problems.push(`the scene: ${scenes.length} code blocks hold "${LABEL.trim()}", not 1`);
  else {
    const { from } = scenes[0];
    const to = scenes[0].to === null ? lines.length : scenes[0].to;
    const start = lines.findIndex((line, i) => i > from && line.includes(LABEL));
    for (let i = start; i < to; i += 1) decided.set(i, '');
    for (let i = from + 1; i < start; i += 1) if (lines[i] === FRAME) decided.set(i, '');
    const before = lines[start].slice(0, lines[start].indexOf(LABEL));
    for (const [i, line] of lines.entries()) {
      if ((i < from || i > to) && /⎿|stop hook error/i.test(line)) problems.push(`line ${i + 1}: the gate's frame outside the scene, where no run checks it: ${line.trim()}`);
    }
    if (!/^\s*⎿\s*$/.test(before)) problems.push(`the scene: the line of "${LABEL.trim()}" has ${JSON.stringify(before)} before it, not the frame's ⎿`);
    if (reply(SCENE) === null || outcome(SCENE, 'gate') === null) notRun.push(`the scene: this run has no reply of the gate on ${SCENE}`);
    else {
      const shown = squash([lines[start].slice(lines[start].indexOf(LABEL) + LABEL.length), ...lines.slice(start + 1, to)].join('\n'));
      const real = squash(reply(SCENE));
      if (outcome(SCENE, 'gate') !== 'red') problems.push(`the scene: the gate does not stop ${SCENE} in this run (${outcome(SCENE, 'gate')})`);
      if (shown !== real) problems.push(`the scene: the gate's reply on ${SCENE} differs from this run's: ${firstDifference(shown, real)}`);
      checked.push('the scene');
    }
  }

  // The banner: the picture of the social preview, whose alt text holds the gate's first line on SCENE.
  const banners = [...lines.entries()].filter(([i, line]) => !inBlock(i) && BANNER.test(line.trim()));
  const first = reply(SCENE) === null ? '' : squash(reply(SCENE).split('\n')[0]);
  if (banners.length !== 1) {
    const at = banners.map(([i]) => i + 1).join(', ');
    problems.push(`the banner: ${banners.length} lines outside code hold only ![alt text](docs/banner.png) with no [, ] or \\ in the alt text, not 1${at ? ` (lines ${at})` : ''}`);
  } else if (!first) {
    decided.set(banners[0][0], '');
    notRun.push(`the banner: this run has no first line of the gate's reply on ${SCENE}`);
  } else {
    const [i, line] = banners[0];
    if (!squash(line.trim().match(BANNER)[1]).includes(first)) {
      problems.push(`line ${i + 1}: the banner's alt text does not hold the first line of the gate's reply on ${SCENE} in this run: ${JSON.stringify(first)}`);
    } else decided.set(i, squash(line).replace(first, ''));
    checked.push('the banner');
  }

  // The table of what else it catches.
  const table = tablesIn('What else it catches');
  if (!sections['What else it catches']) problems.push('the table: no section "## What else it catches"');
  else if (table.length !== 1) problems.push(`the table: ${table.length} tables in "What else it catches", not 1`);
  else {
    const [from, to] = table[0];
    if (lines[from].trim() !== HEADER) problems.push(`the table: its header is ${JSON.stringify(lines[from].trim())}, not ${JSON.stringify(HEADER)}`);
    const delimiter = from + 1 < to ? cells(lines[from + 1]) : [];
    if (delimiter.length !== 3 || !delimiter.every((cell) => /^:?-+:?$/.test(cell))) problems.push('the table: no delimiter row of 3 cells under its header');
    const data = [];
    for (let i = from + 2; i < to; i += 1) data.push(i);
    if (data.length !== ROWS.length) problems.push(`the table: ${data.length} rows of cases, not ${ROWS.length}`);
    for (const [n, [id, did]] of ROWS.entries()) {
      if (n >= data.length) break;
      const row = cells(lines[data[n]]);
      decided.set(data[n], row.slice(0, 2).join(' | '));
      if (row.length !== 3) problems.push(`the table, ${id}: ${row.length} cells, not 3`);
      if (row[0] !== did) problems.push(`the table, ${id}: its row says "${row[0]}", not "${did}"`);
      const tests = outcome(id, 'tests');
      const gate = outcome(id, 'gate');
      if (tests === null || gate === null || reply(id) === null) {
        notRun.push(`the table: this run has no outcome or no reply of the gate on ${id}`);
        continue;
      }
      const [, plain, caught = ''] = row;
      if (!Object.hasOwn(PLAIN, tests)) notRun.push(`the table, ${id}: the tests-only column did not run`);
      else if (plain !== PLAIN[tests]) problems.push(`the table, ${id}: "Plain test run" says "${plain}", this run "${PLAIN[tests]}"`);
      if (gate !== 'red') problems.push(`the table, ${id}: the gate does not stop it in this run (${gate})`);
      // The gate's own findings and result, not the test output it quotes.
      const said = reply(id).split('\nLast ')[0].split('\n').filter((line) => /^(?:- |Result: )./.test(line)).map((line) => line.replace(/^(?:- |Result: )/, ''));
      const shown = unlinkEntries(caught).replace(/^❌ /, '');
      if (!caught.startsWith('❌ ') || !said.includes(shown)) {
        problems.push(`the table, ${id}: "${shown}" is not a finding or result line of the gate's reply in this run, which has: ${JSON.stringify(said.join(' / '))}`);
      }
      checked.push(id);
    }
  }

  // The numbers: the run's summary table, the first table under its heading.
  const want = [];
  for (const line of (run.resultsMd.split(/\r?\n## Summary\r?\n/)[1] || '').split(/\r?\n## /)[0].split(/\r?\n/)) {
    if (line.startsWith('|')) want.push(line);
    else if (want.length) break;
  }
  const numbers = tablesIn('Numbers');
  for (const [from, to] of numbers) for (let i = from; i < to; i += 1) decided.set(i, '');
  if (want.length < 3) notRun.push('the numbers: no summary table in this run\'s RESULTS.md');
  else if (!sections.Numbers) problems.push('the numbers: no section "## Numbers"');
  else if (numbers.length !== 1) problems.push(`the numbers: ${numbers.length} tables in "Numbers", not 1`);
  else {
    const shown = lines.slice(numbers[0][0], numbers[0][1]);
    if (shown.join('\n') !== want.join('\n')) {
      const differs = shown.find((line, i) => line !== want[i]) || '(missing rows)';
      problems.push(`the numbers: the table in "Numbers" is not this run's summary table: ${differs} - the run has ${want.find((line, i) => line !== shown[i]) || '(fewer rows)'}`);
    }
    checked.push('the numbers');
  }

  // No other number, no other image, and every catalog entry a link to its heading.
  const headings = new Map([...catalog.matchAll(/^### (GW-\d+) .*$/gm)].map((m) => [m[1], m[0].slice(4)]));
  let links = 0;
  for (const [i, line] of lines.entries()) {
    if (numberIn(decided.has(i) ? decided.get(i) : line, minNode)) problems.push(`line ${i + 1}: a number no bench run gives: ${line.trim()}`);
    if (inBlock(i)) continue;
    if (line.includes('![') && line.trim() !== BADGE && !BANNER.test(line.trim())) {
      problems.push(`line ${i + 1}: an image other than the license badge and the banner: ${line.trim()}`);
    }
    for (const m of line.matchAll(GW_LINK)) {
      links += 1;
      const heading = headings.get(m[1]);
      if (!heading) problems.push(`line ${i + 1}: ${m[1]} is no entry of CATALOG.md`);
      else if (m[2] !== `CATALOG.md#${slug(heading)}`) problems.push(`line ${i + 1}: ${m[1]} links to ${m[2]}, not CATALOG.md#${slug(heading)}`);
    }
    if (/GW-\p{N}+/u.test(line.replace(GW_LINK, ''))) problems.push(`line ${i + 1}: a catalog entry that is no link to it: ${line.trim()}`);
  }
  if (lines.filter((line, i) => !inBlock(i) && line.trim() === BADGE).length !== 1) problems.push('the license badge: not once on a line of its own');
  checked.push(`${links} catalog links`);
  return { problems, notRun, checked };
}

// root: the repository whose README.md and CATALOG.md are read (the tests give their own).
function main(argv, root = ROOT) {
  if (argv.length > 1) return { code: 2, text: 'usage: node bench/readme [<folder with RESULTS.md, results.json and replies.json>]' };
  const folder = path.resolve(argv[0] || path.join(root, 'bench'));
  let run;
  let readme;
  let catalog;
  try {
    readme = fs.readFileSync(path.join(root, 'README.md'), 'utf8');
    catalog = fs.readFileSync(path.join(root, 'CATALOG.md'), 'utf8');
    run = {
      resultsMd: fs.readFileSync(path.join(folder, 'RESULTS.md'), 'utf8'),
      results: JSON.parse(fs.readFileSync(path.join(folder, 'results.json'), 'utf8')),
      replies: JSON.parse(fs.readFileSync(path.join(folder, 'replies.json'), 'utf8')),
    };
  } catch (error) {
    return { code: 2, text: `README check: did not run - ${error.message}` };
  }
  let outcome;
  try {
    outcome = check(readme, run, catalog);
  } catch (error) {
    // A run whose files hold something else than bench/run writes.
    return { code: 2, text: `README check: did not run - the run's files cannot be read as bench/run writes them: ${error.message}` };
  }
  const { problems, notRun, checked } = outcome;
  const list = (items) => items.map((item) => `- ${item}`).join('\n');
  if (problems.length) return { code: 1, text: `README check: failed - the README is not what this bench run gave\n${list([...problems, ...notRun])}` };
  if (notRun.length) return { code: 2, text: `README check: did not run\n${list(notRun)}` };
  return { code: 0, text: `README check: passed - ${checked.join(', ')} match this bench run (${folder})` };
}

if (require.main === module) {
  const { code, text } = main(process.argv.slice(2));
  process.stdout.write(`${text}\n`);
  process.exitCode = code;
}

module.exports = { check, main, slug, cells, SCENE, ROWS, HEADER, LABEL, FRAME, BADGE };
